# Copier ce fichier en .env (jamais commité) et remplir les valeurs.
# Sur Render, renseigner les mêmes variables dans Environment.

NODE_ENV=production
PORT=4000

# MongoDB Atlas — utilisateur dédié, mot de passe fort
MONGODB_URI=mongodb+srv://<utilisateur>:<mot_de_passe>@<cluster>/food-delivery

# Au moins 32 caractères aléatoires : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1d

# Stripe — clé restreinte (rk_) de préférence ; sk_test_ en local
STRIPE_SECRET_KEY=
# Secret du endpoint webhook (whsec_...) : Dashboard Stripe > Developers > Webhooks,
# endpoint https://<api>/api/stripe/webhook, événements checkout.session.completed,
# checkout.session.async_payment_succeeded, checkout.session.expired
STRIPE_WEBHOOK_SECRET=

# URLs publiques du site client et du panneau admin (CORS + redirections Stripe)
FRONTEND_URL=https://<votre-site>
ADMIN_URL=https://<votre-admin>
# Origines supplémentaires éventuelles, séparées par des virgules
CORS_ORIGINS=
